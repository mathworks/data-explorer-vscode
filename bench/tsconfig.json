{
  // The bench sources are NOT in the root tsconfig: its `rootDir` is `./src`, so a
  // file outside it is an error there, and widening `rootDir` would move every
  // emitted path in `dist/`. This config typechecks bench/ on its own —
  // `npx tsc --noEmit -p bench` — as the second half of `npm run typecheck`, so CI
  // and `npm run verify` catch a bench import a dependency stopped exporting. Nothing
  // else runs the bench (it needs the generated corpus), which is how one such import
  // went unnoticed until the bench itself was run.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/**/*.ts"]
}
